# Jira plugin — required secrets.
# Copy this file to ~/.claude/custom/jira.env and fill in the values.
# ${CLAUDE_PLUGIN_ROOT}/.env is still read as a legacy fallback, but it lives inside
# the versioned plugin directory, so it is left behind on the next version bump.

# Jira Cloud base URL (e.g. https://your-org.atlassian.net). No trailing slash.
JIRA_BASE_URL=

# Atlassian account email used to authenticate the API token below.
JIRA_EMAIL=

# Atlassian API token — generate at:
# https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
